<!DOCTYPE html>
<html>
<head>
  <title>Глоссарий</title>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport"/>
  <meta content="VS BookEditor" name="GENERATOR"/>
  <meta content="" name="keywords"/>
  <meta content="" name="description"/>
  <meta content="no-cache, no-store, must-revalidate" http-equiv="Cache-Control"/>
  <meta content="no-cache" http-equiv="Pragma"/>
  <meta content="0" http-equiv="Expires"/>
  <!-- Стили CSS BEGIN -->
  <link href="../css/bootstrap.min.css" rel="stylesheet"/>
  <link href="../css/service.css" rel="stylesheet"/>
  <!-- Стили CSS END -->
</head>
<body onload="onWindowLoadTestStart()" onunload="onWindowUnload()">
  <div class="container-fluid">
    <!-- Панель инструментов BEGIN -->
    <div class="row mb-sm-1 my-serach-box">
      <!-- Ночной режим BEGIN -->
      <div class="col-sm-12">
        <div class="form-check" id="night_mode">
          <input class="form-check-input" id="night_mode_id" onclick="setNightMode()" title="Включите, чтобы читать в темноте" type="checkbox"/>
          <label class="form-check-label" for="night_mode_id" title="Включите, чтобы читать в темноте">Ночной режим</label>
        </div>
      </div>
      <!-- Ночной режим END -->
    </div>
    <div class="row mb-sm-3">
      <div class="col-sm-12">
{{GlossaryData}}
      </div>
    </div>
  </div>
  <!-- Скрипты BEGIN -->
  <script src="../js/jquery.min.js"></script>
  <script src="../js/bootstrap.bundle.min.js"></script>
  <script src="../js/constants.js"></script>
  <script src="../js/service.js"></script>
  <!-- Скрипты END -->
</body>
</html>